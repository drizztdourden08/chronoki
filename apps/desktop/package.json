{
  "name": "chronoki-desktop",
  "version": "0.1.3",
  "private": true,
  "description": "ChronoKi, a desktop and mobile port of Chrono Trigger.",
  "license": "MIT",
  "type": "module",
  "main": "dist/electron/main.js",
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "dev": "brock dev",
    "build": "brock build",
    "package": "brock package",
    "start": "brock start",
    "start:headless": "brock start -- --no-focus --muted",
    "sync": "brock sync",
    "ensure-wasm": "port-kit-ensure-wasm",
    "typecheck": "tsc --noEmit",
    "lint": "pnpm typecheck && eslint . && stylelint \"src/**/*.css\" && brock prose && jscpd .",
    "lint:md": "markdownlint-cli2",
    "structure": "brock structure --check",
    "deadcode": "brock knip --workspace .",
    "duplicates": "jscpd .",
    "build:web": "brock web build",
    "dev:web": "brock web dev"
  },
  "dependencies": {
    "@capacitor-community/keep-awake": "catalog:",
    "@capacitor/android": "catalog:",
    "@capacitor/app": "catalog:",
    "@capacitor/core": "catalog:",
    "@capacitor/filesystem": "catalog:",
    "@capacitor/haptics": "catalog:",
    "@chronoki/asset-extraction": "workspace:*",
    "@chronoki/design": "workspace:*",
    "@chronoki/features": "workspace:*",
    "@chronoki/game-core": "workspace:*",
    "@chronoki/game-data": "workspace:*",
    "@chronoki/input-mapping": "workspace:*",
    "@drizztdourden08/brock-core": "^0.120.0",
    "@drizztdourden08/brock-display": "^0.120.0",
    "@drizztdourden08/brock-electron": "^0.120.0",
    "@drizztdourden08/brock-game-info": "^0.120.0",
    "@drizztdourden08/brock-input": "^0.120.0",
    "@drizztdourden08/brock-msu": "^0.120.0",
    "@drizztdourden08/brock-port-kit": "^0.120.0",
    "@drizztdourden08/brock-react": "^0.120.0",
    "@drizztdourden08/tessera": "catalog:",
    "@electron-toolkit/utils": "catalog:",
    "jszip": "^3.10.1",
    "koffi": "catalog:",
    "react": "catalog:",
    "react-dom": "catalog:",
    "velopack": "catalog:",
    "zustand": "catalog:"
  },
  "devDependencies": {
    "@capacitor/assets": "^3.0.5",
    "@capacitor/cli": "catalog:",
    "@drizztdourden08/brock-build": "catalog:",
    "@drizztdourden08/brock-lint-config": "catalog:",
    "@types/node": "catalog:",
    "@types/react": "catalog:",
    "@types/react-dom": "catalog:",
    "@vitejs/plugin-react": "catalog:",
    "electron": "catalog:",
    "electron-builder": "catalog:",
    "electron-vite": "catalog:",
    "eslint": "catalog:",
    "jscpd": "catalog:",
    "knip": "catalog:",
    "markdownlint-cli2": "catalog:",
    "stylelint": "catalog:",
    "typescript": "catalog:",
    "vite": "catalog:",
    "vitest": "catalog:"
  },
  "portKit": {
    "wasm": {
      "sourceDirs": [
        "../../core/reconnect",
        "../../core/wasm-build"
      ],
      "sourceExtensions": [
        ".c",
        ".h",
        ".mjs"
      ],
      "buildScript": "../../core/wasm-build/build.mjs",
      "output": "public/wasm",
      "outputExtensions": [
        ".wasm",
        ".js"
      ],
      "emsdkDir": "../../third_party/emsdk"
    }
  },
  "brock": {
    "version": "0.120.0",
    "tessera": "0.93.2"
  }
}
